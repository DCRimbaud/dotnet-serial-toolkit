<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Title>DCRimbaud Serial Toolkit</Title>
    <Description>Reusable .NET serial-port settings, transport abstractions, device enumeration, JSONL rotation, diagnostics ZIP, offline packages, and command response tracking.</Description>
    <PackageId>DCRimbaud.SerialToolkit</PackageId>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/DCRimbaud/dotnet-serial-toolkit</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DCRimbaud/dotnet-serial-toolkit</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>serial;serialport;jsonl;diagnostics;offline-update;embedded;avalonia</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="10.0.12" />
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>
</Project>
