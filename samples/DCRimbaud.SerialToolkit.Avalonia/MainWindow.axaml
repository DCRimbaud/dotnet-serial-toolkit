<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DCRimbaud.SerialToolkit.Avalonia.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        xmlns:vm="using:DCRimbaud.SerialToolkit.Avalonia.ViewModels"
        xmlns:local="using:DCRimbaud.SerialToolkit"
        Width="760" Height="480"
        Title="DCRimbaud Serial Toolkit Sample">
  <Grid RowDefinitions="Auto,*">
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="16">
      <Button x:Name="RefreshButton" Content="Refresh ports" />
      <TextBlock Text="{Binding Status}" VerticalAlignment="Center" />
    </StackPanel>
    <ListBox Grid.Row="1" Margin="16,0,16,16" ItemsSource="{Binding Devices}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="local:SerialPortDevice">
          <StackPanel Spacing="2">
            <TextBlock Text="{Binding PortName}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding DisplayName}" Opacity="0.7" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</Window>
